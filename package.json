{
  "name": "cleverli",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "qa:english-exercises": "npx tsx scripts/audit-translated-exercises.ts en",
    "qa:french-exercises": "npx tsx scripts/audit-translated-exercises.ts fr",
    "qa:italian-exercises": "npx tsx scripts/audit-translated-exercises.ts it",
    "qa:translated-exercises": "npm run qa:english-exercises && npm run qa:french-exercises && npm run qa:italian-exercises",
    "qa:german-scoring-fixes": "npx tsx scripts/audit-german-scoring-fixes.ts",
    "qa:grade5-guillemets": "npx tsx scripts/audit-grade5-swiss-guillemets.ts",
    "qa:grade1-duplicates": "npx tsx scripts/audit-grade1-duplicates.ts",
    "qa:content-correctness": "npx tsx scripts/audit-content-correctness-fixes.ts",
    "qa:lp21-content": "npx tsx scripts/audit-lp21-content.ts",
    "qa:lp21-coverage": "npx tsx scripts/audit-lp21-coverage.ts",
    "qa:lp21-fit": "npx tsx scripts/audit-lp21-exercise-fit.ts",
    "qa:lp21-fit-replacements": "npx tsx scripts/audit-lp21-api-fit-replacements.ts",
    "qa:grade4-data-probability": "npx tsx scripts/audit-grade4-data-probability.ts",
    "qa:guided-composition": "npx tsx scripts/audit-guided-composition.ts",
    "lint:hooks": "npx ts-node --skip-project scripts/check-hooks-order.ts",
    "lp21:gap": "DRY_RUN=1 npx ts-node --skip-project --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"esModuleInterop\\\":true}\" scripts/lp21-gap-analysis.ts",
    "lp21:gap:live": "npx ts-node --skip-project --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\",\\\"moduleResolution\\\":\\\"node\\\",\\\"esModuleInterop\\\":true}\" scripts/lp21-gap-analysis.ts",
    "lp21:fetch": "npx tsx scripts/fetch-lp21-live.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.67.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/pg": "^8.18.0",
    "next": "16.1.6",
    "pg": "^8.19.0",
    "posthog-js": "^1.407.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "stripe": "^20.4.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/glob": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "lighthouse": "^13.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
